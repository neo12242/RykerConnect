<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Berechtigungen für Netzwerk/Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth & Location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- Bevorzugte Ausnahme, um den FGS aus dem Hintergrund zu starten, wenn das
         Companion Device auftaucht (Google empfiehlt diese statt RUN_IN_BACKGROUND). -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>
    <uses-feature android:name="android.software.companion_device_setup"/>

    <permission android:name="de.chaostheorybot.rykerconnect.permission.SHARED_LIBRARY" android:protectionLevel="signature" />
    <uses-permission android:name="de.chaostheorybot.rykerconnect.permission.SHARED_LIBRARY" />
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="de.chaostheorybot.rykerconnect" />
        <package android:name="de.chaostheorybot.rykerconnect.phone" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.RykerConnect"
        android:name=".RykerConnectApplication">
        <provider android:name=".ride.SharedLibraryProvider" android:authorities="${applicationId}.sharedlibrary"
            android:exported="true" android:grantUriPermissions="false"
            android:permission="de.chaostheorybot.rykerconnect.permission.SHARED_LIBRARY" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RykerConnect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".ride.WeatherService" android:exported="false" android:foregroundServiceType="location" />
        <service android:name=".ride.TripRecordingService" android:exported="false" android:foregroundServiceType="location" />
        <activity android:name=".ride.WatchSetupActivity" android:exported="false" />
        <service android:name=".ride.WearRideListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>
                <data android:scheme="wear" android:host="*" android:path="/ryker/ride/request"/>
            </intent-filter>
        </service>
        <activity android:name=".ride.RideToolsActivity" android:exported="false" />
        <activity android:name=".ride.RideActionActivity" android:exported="false" />
        <service android:name=".ride.ServiceReminderJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".ride.DadRidesJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".ride.ParkingMapJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <receiver android:name=".ride.ServiceSnoozeReceiver" android:exported="false" />
        <receiver android:name=".ride.QuickActionsWidget" android:label="Ryker · Quick actions" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quick_actions_widget"/>
        </receiver>
        <receiver android:name=".ride.MyRykerWidget" android:label="Ryker · My Ryker" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/my_ryker_widget"/>
        </receiver>
        <receiver android:name=".ride.LastParkedWidget" android:label="Ryker · Last Parked" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/last_parked_widget"/>
        </receiver>
        <activity android:name=".ride.TripJournalActivity" android:exported="false" />

        <service android:name=".services.RykerDeviceService"
            android:label="@string/companion_service_name"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
        
        <!-- ChargeStateReceiver wird bewusst NICHT hier deklariert: ACTION_BATTERY_CHANGED
             kann laut Doku ausschliesslich ueber Context.registerReceiver() empfangen werden.
             Die Registrierung passiert in RykerDeviceService.initDeviceConnection(). -->

        <receiver android:name=".services.BluetoothConnectReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
